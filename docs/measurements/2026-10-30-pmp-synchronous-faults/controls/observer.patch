+    print(" return_pc=");
+    hex(@atomicLoad(u32, &trace[9], .acquire));
+    print(" return_cause=");
+    hex(@atomicLoad(u32, &trace[10], .acquire));
+    print(" user_marker=");
+    const arena = @atomicLoad(u32, &trace[7], .acquire);
+    if (arena != 0) hex(@atomicLoad(u32, @as(*u32, @ptrFromInt(arena)), .acquire)) else hex(0);
+    print("\n");
+}
