+fn observePmp() void {
+    const trace = &tasks.pmp.nih_pmp_trace;
+    if (@atomicLoad(u32, &trace[6], .acquire) == 0 or observer_printed) return;
+    const seq = @atomicLoad(u32, &trace[5], .acquire);
+    const now = cycle();
+    if (seq != observer_sequence or observer_since == 0) {
+        observer_sequence = seq;
+        observer_since = now;
+        return;
+    }
+    if (now -% observer_since < 90_000_000) return;
