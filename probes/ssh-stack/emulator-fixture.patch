diff --git a/src/platform/native/main.zig b/src/platform/native/main.zig
index cf4497ee..2c771077 100644
--- a/src/platform/native/main.zig
+++ b/src/platform/native/main.zig
@@ -20,0 +21 @@ const ui = display_service.ui;
+var ssh_fixture_done = false;
@@ -1787,0 +1789,18 @@ fn normalReady() linksection(if (native_sqld) ".flash.sqldtext" else ".text") no
+        if (!ssh_fixture_done) {
+            const stack_test = @import("ssh_foreground_stack.zig");
+            const stack_region = @import("sqld_layout.zig");
+            const runtime: *@import("ssh_foreground.zig").Runtime = @ptrFromInt(stack_region.ssh_foreground);
+            runtime.initInPlace();
+            runtime.active = true;
+            stack_test.poll(runtime, null, @ptrFromInt(stack_region.ssh_ui_experiment), ui.timer().counter() orelse fail("SSH fixture clock"));
+            const sp = stack_test.fixture_sp;
+            if (sp < stack_region.ssh_stack + 256 or sp >= stack_region.ssh_stack + stack_region.ssh_stack_bytes) fail("SSH fixture SP");
+            if (!stack_test.fixture_reentry_rejected or stack_test.fixture_after == stack_test.fixture_before) fail("SSH fixture interrupt");
+            const check_stack: []u8 = @as([*]u8, @ptrFromInt(stack_region.ssh_stack))[0..stack_region.ssh_stack_bytes];
+            if (!tasks.memory.stacks.beginForeground(check_stack)) fail("SSH fixture release");
+            tasks.memory.stacks.endForeground();
+            const bytes: []const u8 = @as([*]const u8, @ptrFromInt(stack_region.ssh_stack))[16..stack_region.ssh_stack_bytes];
+            for (bytes) |byte| if (byte != 0) fail("SSH fixture clear");
+            print("NIHOS_SSH_STACK_FIXTURE_PASS\n");
+            ssh_fixture_done = true;
+        }
