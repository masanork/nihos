diff --git a/src/platform/native/ssh_foreground_stack.zig b/src/platform/native/ssh_foreground_stack.zig
index 4531f425..21a78ef3 100644
--- a/src/platform/native/ssh_foreground_stack.zig
+++ b/src/platform/native/ssh_foreground_stack.zig
@@ -49,0 +50,2 @@ pub noinline fn poll(runtime: *owner.Runtime, model: ?*ssh.Model, ui: *ssh.Ui, n
+    // The real admission gate must still reject reentry after the wipe.
+    if (tasks.memory.stacks.beginForeground(stack)) nih_native_task_failed();
@@ -56,3 +58,16 @@ comptime {
-fn onStack(call: *const Call) linksection(".flash.xytext") callconv(.c) void {
-    if (comptime !owner.qualified) return;
-    call.runtime.poll(call.model, call.ui, call.now);
+pub var fixture_sp: u32 = 0;
+pub var fixture_before: u32 = 0;
+pub var fixture_after: u32 = 0;
+pub var fixture_reentry_rejected: bool = false;
+fn onStack(_: *const Call) callconv(.c) void {
+    fixture_sp = asm volatile ("mv %[v],sp" : [v] "=r" (-> u32));
+    const stack: []u8 = @as([*]u8, @ptrFromInt(region.ssh_stack))[0..region.ssh_stack_bytes];
+    fixture_reentry_rejected = !tasks.memory.stacks.beginForeground(stack);
+    fixture_before = tasks.report(0).ticks;
+    var spins: u32 = 0;
+    while (spins < 20_000_000 and tasks.report(0).ticks == fixture_before) : (spins += 1) {
+        asm volatile ("" ::: .{ .memory = true });
+    }
+    fixture_after = tasks.report(0).ticks;
+    var marker: [256]u8 = @splat(0x6b);
+    asm volatile ("" :: [p] "r" (&marker) : .{ .memory = true });
